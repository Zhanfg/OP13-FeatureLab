{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/op13-featurelab/feature.schema.json",
  "title": "OP13 FeatureLab feature definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "category",
    "channel",
    "risk",
    "default_enabled",
    "evidence",
    "operations",
    "activation_stage",
    "rollback"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": {
      "enum": [
        "display",
        "audio",
        "network",
        "wlan",
        "nfc",
        "satellite",
        "aon",
        "window",
        "touch",
        "charging",
        "system_ui",
        "performance",
        "other"
      ]
    },
    "channel": { "enum": ["stable", "lab"] },
    "risk": { "enum": ["low", "medium", "high"] },
    "default_enabled": { "type": "boolean" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": [
            "declared",
            "consumer_found",
            "hal_present",
            "driver_present",
            "hardware_verified"
          ]
        },
        "notes": { "type": "string" },
        "probes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "activation_stage": {
      "enum": ["install", "post-mount", "late-load", "service", "reboot"]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target", "selector"],
        "properties": {
          "type": {
            "enum": [
              "xml_add",
              "xml_update",
              "xml_remove_exact",
              "list_append",
              "permission_add",
              "property_set",
              "runtime_action"
            ]
          },
          "target": { "type": "string", "pattern": "^/" },
          "selector": { "type": "string", "minLength": 1 },
          "value": {},
          "preserve_unrelated": { "const": true }
        }
      }
    },
    "protected_domains": {
      "type": "array",
      "items": {
        "enum": [
          "credentials",
          "keyguard",
          "privacy_password",
          "privileged_permissions",
          "biometrics",
          "camera_boundary"
        ]
      },
      "uniqueItems": true
    },
    "binary_search_bucket": { "type": "string" },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "verify"],
      "properties": {
        "strategy": { "enum": ["baseline_restore", "property_restore", "service_restore"] },
        "verify": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
