{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/op13-featurelab/media-decoder-evidence.schema.json",
  "title": "FeatureLab media decoder evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at_utc", "device", "candidate_manifest_sha256", "decoders"],
  "properties": {
    "schema": {"const": 1},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "sdk", "build_fingerprint_sha256"],
      "properties": {
        "product": {"type": "string", "minLength": 1},
        "sdk": {"type": "integer", "minimum": 1},
        "build_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decoders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mime", "component", "decoder_discovered", "create_ok", "output_mime", "pcm_bytes", "pcm_frames", "input_sha256", "pcm_sha256"],
        "properties": {
          "mime": {"type": "string", "pattern": "^audio/[A-Za-z0-9.+_-]+$"},
          "component": {"type": "string", "minLength": 1},
          "decoder_discovered": {"type": "boolean"},
          "create_ok": {"type": "boolean"},
          "output_mime": {"const": "audio/raw"},
          "pcm_bytes": {"type": "integer", "minimum": 1},
          "pcm_frames": {"type": "integer", "minimum": 1},
          "duration_ms": {"type": "integer", "minimum": 1},
          "sample_rate": {"type": "integer", "minimum": 1},
          "channel_count": {"type": "integer", "minimum": 1},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "pcm_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
