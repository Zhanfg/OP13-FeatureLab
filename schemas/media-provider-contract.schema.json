{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/op13-featurelab/media-provider-contract.schema.json",
  "title": "FeatureLab media provider ABI/runtime contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at_utc",
    "target",
    "edges",
    "closures",
    "target_platform_contracts"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "sdk",
        "build_fingerprint_sha256"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1
        },
        "sdk": {
          "type": "integer",
          "minimum": 1
        },
        "build_fingerprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "edge_type",
          "consumer",
          "requirement",
          "resolution",
          "architecture",
          "soname",
          "symbol_abi",
          "namespace",
          "evidence_sha256"
        ],
        "properties": {
          "edge_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "edge_type": {
            "enum": [
              "elf-dt-needed",
              "elf-dlopen-candidate",
              "init-exec",
              "init-interface",
              "vintf-instance",
              "media-codec-include",
              "codec-component-library",
              "audio-effect-library",
              "config-file-reference",
              "property-trigger",
              "selinux-context-requirement"
            ]
          },
          "consumer": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "provider_partition": {
            "enum": [
              "system",
              "system_ext",
              "product",
              "vendor",
              "odm",
              "apex",
              "unknown",
              "not-applicable"
            ]
          },
          "resolution": {
            "enum": [
              "static-resolved",
              "declarative-resolved",
              "observed-runtime",
              "unresolved",
              "candidate"
            ]
          },
          "architecture": {
            "enum": [
              "match",
              "mismatch",
              "unknown",
              "not-applicable"
            ]
          },
          "soname": {
            "enum": [
              "match",
              "mismatch",
              "unknown",
              "not-applicable"
            ]
          },
          "symbol_abi": {
            "enum": [
              "satisfied",
              "unsatisfied",
              "unknown",
              "not-applicable"
            ]
          },
          "namespace": {
            "enum": [
              "visible",
              "not-visible",
              "unknown",
              "not-applicable"
            ]
          },
          "evidence_sha256": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "closures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static",
        "declarative",
        "observed_runtime"
      ],
      "properties": {
        "static": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "declarative": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "observed_runtime": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        }
      }
    },
    "target_platform_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "consumer",
          "dependency",
          "source_classification",
          "target_classification",
          "architecture",
          "soname",
          "symbol_abi",
          "namespace",
          "target_evidence_sha256"
        ],
        "properties": {
          "consumer": {
            "type": "string",
            "minLength": 1
          },
          "dependency": {
            "type": "string",
            "minLength": 1
          },
          "source_classification": {
            "enum": [
              "source-platform-provided",
              "source-private",
              "not-applicable"
            ]
          },
          "target_classification": {
            "enum": [
              "compatible",
              "missing",
              "abi-mismatch",
              "namespace-invisible",
              "unknown"
            ]
          },
          "architecture": {
            "enum": [
              "match",
              "mismatch",
              "unknown"
            ]
          },
          "soname": {
            "enum": [
              "match",
              "mismatch",
              "unknown"
            ]
          },
          "symbol_abi": {
            "enum": [
              "satisfied",
              "unsatisfied",
              "unknown"
            ]
          },
          "namespace": {
            "enum": [
              "visible",
              "not-visible",
              "unknown"
            ]
          },
          "required_symbols": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_symbol_versions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target_provider": {
            "type": "string",
            "minLength": 1
          },
          "target_evidence_sha256": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
